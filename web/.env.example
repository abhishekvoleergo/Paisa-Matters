# PaisaMatters Web Client Environment Variables (Template)
# Copy this file to .env.local for local development

# Public API Base URL
# - Local development: http://localhost:5000/api
# - Vercel production: /api (routes through Next.js rewrite proxy to avoid cross-origin cookie issues)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api

# Server-side proxy target used by Next.js rewrites in next.config.ts (Vercel production only)
# API_PROXY_TARGET=https://paisamatters-api.runasp.net/api

# Application Metadata
NEXT_PUBLIC_APP_NAME=PaisaMatters
NEXT_PUBLIC_APP_URL=http://localhost:3000
